mixin NavbarFoodwagon
  nav.navbar.navbar-expand-lg.navbar-light.bg-light(data-navbar-on-scroll)
    .container
      a.navbar-brand.d-inline-flex(href='index.html' aria-label='Foodwagon home')
        img.d-inline-block(src=`${CWD}assets/img/gallery/logo.svg` alt='')
        span.foodwagon-wordmark foodwaGon
      button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation')
        span.navbar-toggler-icon
      #navbarSupportedContent.collapse.navbar-collapse
        ul.navbar-nav.foodwagon-nav-links.mx-lg-auto
          li.nav-item
            a.nav-link.active(href='#home') Home
          li.nav-item
            a.nav-link(href='#carouselPopularItems') Menu
          li.nav-item
            a.nav-link(href='#how-it-works') Services
          li.nav-item
            a.nav-link(href='#site-footer') About
        .foodwagon-nav-actions
          form.foodwagon-nav-search(role='search')
            .input-group-icon.pe-2
              i.fas.fa-search.input-box-icon(aria-hidden='true')
              input.form-control.border-0.input-box.bg-100(type='search' placeholder='Search food' aria-label='Search food')
          button.foodwagon-cart-link(type='button' data-bs-toggle='modal' data-bs-target='#orderModal' aria-label='Start an order')
            i.fas.fa-shopping-bag(aria-hidden='true')
          button.btn.foodwagon-login(type='button')
            i.fas.fa-user.me-2(aria-hidden='true')
            | Login