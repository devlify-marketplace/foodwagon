append variables
  -
    var foodPicks = [
      {
        image:'refresh/jollof-chicken.webp',
        alt:'A pan of jollof rice with chicken and fresh vegetables',
        title:'Jollof & chicken',
        tag:'A proper favourite',
      },
      {
        image:'refresh/hero-platter.webp',
        alt:'A Nigerian sharing platter with rice, suya, plantain and sides',
        title:'Jollof & suya',
        tag:'Made to share',
      },
      {
        image:'refresh/table-spread.webp',
        alt:'A colourful spread of rice, stew, snacks and fresh sides',
        title:'Something for everyone',
        tag:'Gather around',
      },
      {
        image:'refresh/family-platter.webp',
        alt:'A generous meal plate with rice, grilled chicken and salad',
        title:'The full spread',
        tag:'Big flavour energy',
      },
    ];

mixin FoodPick(config)
  .col-sm-6.col-lg-3.mb-4(data-reveal)
    a.food-pick-card(href='#carouselPopularItems' aria-label=`Explore ${config.title} in popular items`)
      .food-pick-card__photo
        img(src=`${CWD}assets/img/${config.image}` alt=config.alt loading='lazy')
      .food-pick-card__body
        span.food-pick-card__tag=config.tag
        h3=config.title
        span.food-pick-card__link
          | Explore menu
          i.fas.fa-arrow-right(aria-hidden='true')

mixin Discount
  +Section.py-5
    .food-picks
      .food-picks__heading(data-reveal)
        p.food-section-kicker Good things to start with
        h2 Pick a craving
        p A few delicious directions to take your next order.
      .row.g-3.g-xl-4
        each item in foodPicks
          +FoodPick(item)